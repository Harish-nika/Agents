# Copy to .env and edit before first run: cp .env.example .env

APP_USERNAME=hr
APP_PASSWORD=change-me-strong-password

API_PORT=8512
APP_PORT=8510

# Ollama (required for embeddings; optional for LLM if using Groq)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_GPU_BASE_URL=
OLLAMA_LLM_MODEL=llama3.1:8b
OLLAMA_FAST_MODEL=qwen2.5:0.5b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TIMEOUT=300

# Groq (optional — speeds up LLM scoring/verification; set key in UI Settings instead)
GROQ_LLM_MODEL=llama-3.3-70b-versatile
GROQ_FAST_MODEL=llama-3.1-8b-instant

SUSPICION_THRESHOLD=60
PORT_RANGE_START=8510
PORT_RANGE_END=8520
