# Google AI Studio / Gemini API key
GOOGLE_API_KEY=your_api_key_here

# Optional: Google Maps Directions
GOOGLE_MAPS_API_KEY=your_maps_api_key_here

# Optional: Groq fallback LLM (console.groq.com) — also accepted as grok_key=
GROQ_API_KEY=your_groq_api_key_here
# grok_key=your_groq_api_key_here
# GROQ_MODEL=groq/llama-3.3-70b-versatile
# GROQ_MODEL_FALLBACKS=groq/llama-3.1-8b-instant,groq/openai/gpt-oss-20b
# Unlimited Compound research via compound_research tool (needs underlying models
# enabled in Groq project settings — Compound itself has no ADK tool calling).

GOOGLE_GENAI_USE_VERTEXAI=False

# TRIP_PLANNER_MODEL=gemini-2.0-flash
# TRIP_PLANNER_MODEL_FALLBACKS=gemini-flash-latest,gemini-2.0-flash

# Set to 1 when Gemini free-tier daily quota is exhausted
# TRIP_PLANNER_SKIP_GEMINI=1
# Runtime mode: auto | local | cloud (also settable in Settings UI)
TRIP_PLANNER_RUNTIME_MODE=auto
# Per-model attempt timeout seconds (default 50; Ollama default 120)
# TRIP_PLANNER_MODEL_TIMEOUT_S=50
# TRIP_PLANNER_OLLAMA_TIMEOUT_S=120

# Local GPU via Ollama. Prefer a tool-capable tag.
OLLAMA_API_BASE=http://127.0.0.1:11434
OLLAMA_MODEL=ollama/llama3-groq-tool-use:latest
OLLAMA_MODEL_FALLBACKS=ollama/llama3.1:latest
