# Google AI Studio / Gemini API key
GOOGLE_API_KEY=your_api_key_here

# Optional: Google Maps Directions
GOOGLE_MAPS_API_KEY=your_maps_api_key_here

# Optional: Groq fallback LLM (console.groq.com) — also accepted as grok_key=
GROQ_API_KEY=your_groq_api_key_here
# grok_key=your_groq_api_key_here
# GROQ_MODEL=groq/qwen/qwen3.8-27b
# GROQ_MODEL_FALLBACKS=groq/openai/gpt-oss-20b
# Unlimited Compound research via compound_research tool (needs underlying models
# enabled in Groq project settings — Compound itself has no ADK tool calling).

GOOGLE_GENAI_USE_VERTEXAI=False

# TRIP_PLANNER_MODEL=gemini-3.6-flash
# TRIP_PLANNER_MODEL_FALLBACKS=gemini-flash-latest,gemini-2.0-flash

# Set to 1 when Gemini free-tier daily quota is exhausted (use Groq only)
# TRIP_PLANNER_SKIP_GEMINI=1
# Per-model attempt timeout seconds (default 50)
# TRIP_PLANNER_MODEL_TIMEOUT_S=50
